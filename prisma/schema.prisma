generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ApiCache {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  source      String
  createdAt   DateTime @default(now())
}

model LocationSearch {
  id           String   @id @default(cuid())
  query        String
  displayName  String
  lat          Float
  lon          Float
  aqiData      String?
  weatherData  String?
  fireData     String?
  trafficData  String?
  createdAt    DateTime @default(now())
}

model AirQualityRecord {
  id          String   @id @default(cuid())
  locationId  String?
  lat         Float
  lon         Float
  area        String?
  pm25        Float?
  pm10        Float?
  no2         Float?
  o3          Float?
  so2         Float?
  co          Float?
  nh3         Float?
  aqi         Int?
  temp        Float?
  humidity    Float?
  pressure    Float?
  windSpeed   Float?
  uvIndex     Float?
  source      String?
  timestamp   DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  phoneNumber  String?   @unique
  createdAt    DateTime  @default(now())
  sessions     Session[]
  tracked      TrackedLocation[]
}

model TrackedLocation {
  id          String   @id @default(cuid())
  query       String
  displayName String
  lat         Float
  lon         Float
  threshold   Int      @default(150) // Default threshold for alerts (e.g., Unhealthy)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, lat, lon])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([expiresAt])
}
