# OpenWeather API - https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# NASA FIRMS - https://firms.modaps.eosdis.nasa.gov/
NASA_FIRMS_KEY=your_nasa_firms_key

# WAQI - World Air Quality Index - https://aqicn.org/api/
WAQI_TOKEN=your_waqi_token

# TomTom Traffic - https://developer.tomtom.com/
TOMTOM_KEY=your_tomtom_key

# GROQ for LLM-based health advisories - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_placeholder

# Database
DATABASE_URL=file:./prisma/dev.db
